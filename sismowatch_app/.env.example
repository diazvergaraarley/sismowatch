# ==============================================================================
# SismoWatch - Variables de Entorno del Sistema
# ------------------------------------------------------------------------------
# Copia este archivo a .env antes de levantar la infraestructura:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Almacenamiento Medallón)
# ------------------------------------------------------------------------------
POSTGRES_USER=sismo_user
POSTGRES_PASSWORD=sismo_password
POSTGRES_DB=sismowatch
# Puerto expuesto en el host (5434 para evitar colisiones con instancias locales en 5432)
POSTGRES_PORT=5434

# ------------------------------------------------------------------------------
# 2. Apache Airflow (Orquestación de Pipelines)
# ------------------------------------------------------------------------------
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW_UID=1001
AIRFLOW__WEBSERVER__SECRET_KEY=sismowatch_airflow_secret_key_2026

# ------------------------------------------------------------------------------
# 3. Inteligencia Artificial (OpenAI API para Agente Text-to-SQL)
# Reemplaza 'your_openai_api_key_here' con tu clave API de OpenAI activa (sk-...)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Seguridad, Autenticación y Control de Acceso (RBAC + JWT)
# ------------------------------------------------------------------------------
# Credenciales para usuario con permisos de Administrador
ADMIN_USER=admin
ADMIN_PASSWORD=supersecreto

# Credenciales para usuario con permisos de Visualizador
VIEWER_USER=viewer
VIEWER_PASSWORD=sololeer

# Clave secreta para la firma y verificación de tokens JWT (HS256)
JWT_SECRET=sismowatch_firma_secreta_2026
